<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Calculadora.aspx.cs" Inherits="PRUEBAasp1.Calculadora" %>
<!DOCTYPE html><html xmlns="http://www.w3.org/1999/xhtml"><head runat="server"><meta charset="UTF-8" /><title>Calculadora</title><style>body { font-family: Segoe UI, Arial; background:#f0f2f5; }
.caja { width:340px; margin:60px auto; background:#fff; padding:25px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,.15); text-align:center; }
.campo { width:90%; padding:8px; margin:6px 0; font-size:18px; }
.op { width:60px; height:50px; font-size:22px; margin:4px; cursor:pointer; }
.resultado { font-size:26px; margin-top:15px; color:#0a6; font-weight:bold; }
.error { color:#c00; }</style></head><body><form id="form1" runat="server"><div class="caja"><h2>Calculadora</h2><asp:TextBox ID="txtNumero1" runat="server" CssClass="campo" placeholder="Primer numero"></asp:TextBox><asp:TextBox ID="txtNumero2" runat="server" CssClass="campo" placeholder="Segundo numero"></asp:TextBox><div><asp:Button ID="btnSumar" runat="server" Text="+" CssClass="op" CommandArgument="+" OnClick="Operar_Click" /><asp:Button ID="btnRestar" runat="server" Text="-" CssClass="op" CommandArgument="-" OnClick="Operar_Click" /><asp:Button ID="btnMultiplicar" runat="server" Text="*" CssClass="op" CommandArgument="*" OnClick="Operar_Click" /><asp:Button ID="btnDividir" runat="server" Text="/" CssClass="op" CommandArgument="/" OnClick="Operar_Click" /></div><asp:Label ID="lblResultado" runat="server" CssClass="resultado"></asp:Label><br /><br /><asp:Button ID="btnLimpiar" runat="server" Text="Limpiar" OnClick="btnLimpiar_Click" /><asp:HyperLink ID="lnkInicio" runat="server" NavigateUrl="~/Default.aspx">Volver al inicio</asp:HyperLink></div></form></body></html>
